# Copy to airflow/.env (gitignored) and fill in real values.
AIRFLOW_UID=50000

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SKYPOINTS_DBT
# Key-pair auth, not a password — see setup/snowflake_bootstrap.sql §8.
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/skypoints_dbt_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=SKYPOINTS_TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=SKYPOINTS
