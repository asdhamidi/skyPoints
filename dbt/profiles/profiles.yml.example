# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this folder) and fill in the
# Snowflake values via environment variables. Never commit the real profiles.yml — it is
# gitignored. See docs/02_Tech_Stack_Specification.md §3, §7.

skypoints:
  target: duckdb
  outputs:

    # Local development only — never used for the live demo or as the authority on
    # Snowflake-specific behavior. make dbt-fast targets this.
    duckdb:
      type: duckdb
      path: 'skypoints_dev.duckdb'
      threads: 4

    # Production / live-demo target, run by Airflow's isolated dbt venv.
    # Key-pair auth, not a password — see setup/snowflake_bootstrap.sql §8 for why
    # and how to generate the key. private_key_passphrase is optional (blank if
    # the key was generated with -nocrypt, as the bootstrap script's instructions do).
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE', '') }}"
      role: SKYPOINTS_TRANSFORMER
      database: SKYPOINTS
      warehouse: TRANSFORM_WH
      schema: STAGING
      threads: 4
